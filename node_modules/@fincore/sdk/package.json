{
  "name": "@fincore/sdk",
  "version": "0.1.3",
  "description": "TypeScript SDK for Fin-Core hosted tenant APIs.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fincore",
    "sdk",
    "api",
    "hosted"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    ".env.example",
    "LICENSE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"import('node:fs').then((fs) => fs.rmSync('dist', { recursive: true, force: true }))\" && tsc -p tsconfig.json",
    "hello": "npm run build && tsx --env-file=.env examples/hello.ts",
    "prepack": "npm run build",
    "test": "vitest run",
    "pack:local": "npm pack"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
